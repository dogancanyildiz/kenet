xcuserdata/
*.xcuserstate
*.xcscmblueprint
*.xccheckout

# XcodeGen ile üretilir: `xcodegen generate` (tanım project.yml içinde)
Journal.xcodeproj/

# Derleme çıktıları
build/
DerivedData/
*.ipa
*.dSYM
*.dSYM.zip

# ----------------------------------------
# Swift Package Manager
# ----------------------------------------
.build/
.swiftpm/
# Package.resolved bilerek takip edilir: herkes aynı bağımlılık sürümünü kullansın

# ----------------------------------------
# Gizli bilgiler
# ----------------------------------------
# Ortam değişkenleri ve anahtarlar repoya girmez
.env
.env.*
!.env.example
*.p8
*.p12
*.mobileprovision
*.pem
# Takım kimliği gibi makineye özgü imzalama ayarları (örnek: Config/Local.xcconfig.example)
Config/Local.xcconfig

# fastlane çıktıları (ileride CD için)
fastlane/report.xml
fastlane/Preview.html
fastlane/screenshots/
fastlane/test_output/

# ----------------------------------------
# Kişisel veri
# ----------------------------------------
# Gerçek kasa repoya girmez; yalnızca Fixtures/ altındaki kurgusal örnek kasa takip edilir
Vault/
vault/
.obsidian/
# Fixture kasalarındaki .obsidian klasörü sınanan girdidir.
!Fixtures/**/.obsidian/


# ----------------------------------------
# Ajan ve editör dosyaları
# ----------------------------------------
# Kişisel Claude Code ayarları; paylaşılan .claude/settings.json takip edilir
.claude/settings.local.json
.idea/
.vscode/
.nodeterm/

