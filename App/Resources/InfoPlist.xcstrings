{
  "sourceLanguage": "tr",
  "strings": {
    "NSLocationAlwaysAndWhenInUseUsageDescription": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenet, seçtiğin bir konuma vardığında, örneğin spor salonuna girdiğinde, o konuma bağlı hedefi işaretlemek ya da sana hatırlatmak için uygulama kapalıyken de konumunu kullanır. Konum bilgin kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenet uses your location even when the app is closed so that arriving at a place you chose, such as your gym, can mark the goal linked to it or remind you. Your location is not saved and is not sent anywhere."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenet konumunu, yazarken yakınındaki kayıtlı konumlarını önermek ve haritada yerini göstermek için kullanır. Konum bilgin kaydedilmez ve hiçbir yere gönderilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Kenet uses your location to suggest your saved places nearby while you write and to show where you are on the map. Your location is not saved and is not sent anywhere."
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Bugünün takvim etkinliklerini göstermek için takvim erişimi gerekir. Etkinlikler değiştirilmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Calendar access is needed to show today's events. Events are never modified."
          }
        }
      }
    },
    "NSFaceIDUsageDescription": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Günlüğünün kilidini açmak için Face ID kullanılır."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Face ID is used to unlock your journal."
          }
        }
      }
    }
  },
  "version": "1.0"
}
