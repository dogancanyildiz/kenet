      }
    },
    "CFBundleName" : {
      "comment" : "Bundle name",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "tr" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Journal"
          }
        }
      }
    },
    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Privacy - Calendars Full Access Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendar access is needed to show today's events. Events are never modified."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bugünün takvim etkinliklerini göstermek için takvim erişimi gerekir. Etkinlikler değiştirilmez."
          }
        }
      }
    },
    "NSFaceIDUsageDescription" : {
      "comment" : "Privacy - Face ID Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Face ID is used to unlock your journal."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Günlüğünün kilidini açmak için Face ID kullanılır."
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location Always and When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenet uses your location even when the app is closed so that arriving at a place you chose, such as your gym, can mark the goal linked to it or remind you. Your location is written to a place's file only when you tap Save to store it as that place's coordinates; it is never sent anywhere."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenet, seçtiğin bir konuma vardığında, örneğin spor salonuna girdiğinde, o konuma bağlı hedefi işaretlemek ya da sana hatırlatmak için uygulama kapalıyken de konumunu kullanır. Konumun yalnız sen bir konumun koordinatı olarak Kaydet dediğinde o konumun dosyasına yazılır; hiçbir yere gönderilmez."
          }
        }
      }
    },
    "NSLocationWhenInUseUsageDescription" : {
      "comment" : "Privacy - Location When In Use Usage Description",
      "localizations" : {
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenet uses your location to suggest your saved places nearby as you write, to show where you are on the map, and to fill in a place's coordinates when you ask. Your location is written to that place's file only when you tap Save; it is never sent anywhere."
          }
        },
        "tr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kenet konumunu, yazarken yakınındaki kayıtlı konumlarını önermek, haritada yerini göstermek ve sen istediğinde bir konumun koordinatını doldurmak için kullanır. Konumun yalnız sen Kaydet dediğinde o konumun dosyasına yazılır; hiçbir yere gönderilmez."
          }
        }
      }
    }
  },
  "version" : "1.0"
}