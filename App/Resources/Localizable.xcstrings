    "Kasaya erişilemiyor. Journal'da kasanı açıp yeniden dene.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kasaya erişilemiyor. Journal'da kasanı açıp yeniden dene."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The vault is unavailable. Open your vault in Journal and try again."
          }
        }
      }
    },
    "Eklenecek metin boş olamaz.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Eklenecek metin boş olamaz."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Entry text cannot be empty."
          }
        }
      }
    },
    "Kayıt yazılamadı. Kasa erişimini ve metni kontrol et.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Kayıt yazılamadı. Kasa erişimini ve metni kontrol et."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The entry could not be saved. Check vault access and the text."
          }
        }
      }
    },
    "Hedef bulunamadı. Kısayolda hedefi yeniden seç.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hedef bulunamadı. Kısayolda hedefi yeniden seç."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The goal was not found. Select it again in your shortcut."
          }
        }
      }
    },
    "Sayısal hedef için sıfır veya daha büyük, sonlu bir miktar gir.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Sayısal hedef için sıfır veya daha büyük, sonlu bir miktar gir."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Enter a finite amount of zero or greater for a numeric goal."
          }
        }
      }
    },
    "Hızlı girişteki konum önerisi tek seferlik konumla çalışır; olayına kendiliğinden eklenmez.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Hızlı girişteki konum önerisi tek seferlik konumla çalışır; olayına kendiliğinden eklenmez."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Quick entry suggestions use a single location fix; a place is never added to your event automatically."
          }
        }
      }
    },
    "Konum bölgesi izlenemedi. Konum iznini ve sistem ayarlarını kontrol et.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Konum bölgesi izlenemedi. Konum iznini ve sistem ayarlarını kontrol et."
