    "Klasör açıldı ancak yer imi yenilenemedi. Sonraki açılışta yeniden denenecek.": {
      "localizations": {
        "tr": {
          "stringUnit": {
            "state": "translated",
            "value": "Klasör açıldı ancak yer imi yenilenemedi. Sonraki açılışta yeniden denenecek."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The folder was opened but its bookmark could not be renewed. It will be retried on the next launch."
          }
        }
      }
    },
