        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "A location region could not be monitored. Check location permission and system settings."
          }
        }
      }
    },
    "Konum hedefi işlenemedi. Kasayı ve bildirim izinlerini kontrol et.": {
      "localizations": {
        "tr": {
